&НаКлиенте
Процедура ЗагрузитьФайлы(Команда)
	ЗагрузитьФайлыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьФайлыНаСервере()
	
	ПутьВходящие = "C:\Exchange\Inbox\";
	ПутьАрхив    = "C:\Exchange\Archive\";
	
	НайденныеФайлы = НайтиФайлы(ПутьВходящие, "*.json");
	
	Если НайденныеФайлы.Количество() = 0 Тогда
		Сообщить("Новых файлов в папке Inbox нет.");
		Возврат;
	КонецЕсли;
	
	Для Каждого Файл Из НайденныеФайлы Цикл
		
		Попытка
	
			Чтение = Новый ЧтениеJSON;
			Чтение.ОткрытьФайл(Файл.ПолноеИмя, "UTF-8");
			Данные = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			
			
			Док = Документы.ПоступлениеЖивотных.СоздатьДокумент();
			Док.Дата      = ТекущаяДата();
			Док.Поставщик = Данные["Поставщик"];
			Док.Сотрудник = Справочники.Сотрудники.НайтиПоНаименованию(Данные["Сотрудник"]);
			
			
			Для Каждого Стр Из Данные["Животные"] Цикл
				
				НоваяСтрока = Док.Животные.Добавить();
				НоваяСтрока.ВидЖивотного     = Справочники.ВидыЖивотных.НайтиПоНаименованию(Стр["ВидЖивотного"]);
				НоваяСтрока.Кличка           = Стр["Кличка"];
				НоваяСтрока.ДатаРождения     = XMLЗначение(Тип("Дата"), Стр["ДатаРождения"]);
				НоваяСтрока.ИнвентарныйНомер = Стр["ИнвентарныйНомер"];
				НоваяСтрока.Вес              = Стр["Вес"];
				
				Если Стр["Пол"] = "Мужской" Тогда
					НоваяСтрока.Пол = Перечисления.ПолЖивотного.Мужской;
				Иначе
					НоваяСтрока.Пол = Перечисления.ПолЖивотного.Женский;
				КонецЕсли;
								
			КонецЦикла;
			
			
			Док.Записать(РежимЗаписиДокумента.Проведение);
			ПереместитьФайл(Файл.ПолноеИмя, ПутьАрхив + Файл.Имя);
			
			Сообщить("Загружен файл " + Файл.Имя + ". Проведён документ №" + Док.Номер);
			
		Исключение
			Сообщить("Ошибка обработки файла " + Файл.Имя + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры
