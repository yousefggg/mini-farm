
Процедура ПечатьАктаПриемки(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(ПечатьАктаПриемки)
	Макет = Документы.ПоступлениеЖивотных.ПолучитьМакет("ПечатьАктаПриемки");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеЖивотных.Дата,
	|	ПоступлениеЖивотных.Номер,
	|	ПоступлениеЖивотных.Поставщик,
	|	ПоступлениеЖивотных.Сотрудник,
	|	ПоступлениеЖивотных.Животные.(
	|		НомерСтроки,
	|		ВидЖивотного,
	|		Кличка,
	|		ДатаРождения,
	|		НомерСтроки,
	|		ИнвентарныйНомер,
	|		Вес,
	|		Цена
	|	)
	|ИЗ
	|	Документ.ПоступлениеЖивотных КАК ПоступлениеЖивотных
	|ГДЕ
	|	ПоступлениеЖивотных.Ссылка В (&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьЖивотныеШапка = Макет.ПолучитьОбласть("ЖивотныеШапка");
	ОбластьЖивотные = Макет.ПолучитьОбласть("Животные");
	Подвал = Макет.ПолучитьОбласть("Подвал");

	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабДок.Вывести(ОбластьЗаголовок);

		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());

		ТабДок.Вывести(ОбластьЖивотныеШапка);
		ВыборкаЖивотные = Выборка.Животные.Выбрать();
		Пока ВыборкаЖивотные.Следующий() Цикл
			ОбластьЖивотные.Параметры.Заполнить(ВыборкаЖивотные);
			ТабДок.Вывести(ОбластьЖивотные, ВыборкаЖивотные.Уровень());
		КонецЦикла;

		Подвал.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Подвал);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры
