
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Движения.Поголовье.Записывать = Истина;
	
    Для Каждого СтрокаЖивотного Из Животные Цикл
		
		НовыйЖивотный = Справочники.Животные.СоздатьЭлемент();
        НовыйЖивотный.Наименование = СтрокаЖивотного.Кличка;
        НовыйЖивотный.ВидЖивотного = СтрокаЖивотного.ВидЖивотного;
        НовыйЖивотный.ДатаРождения = СтрокаЖивотного.ДатаРождения;
        НовыйЖивотный.Пол = СтрокаЖивотного.Пол;
        НовыйЖивотный.ИнвентарныйНомер = СтрокаЖивотного.ИнвентарныйНомер;
        НовыйЖивотный.Вес = СтрокаЖивотного.Вес;
        НовыйЖивотный.Записать();
		
        Движение = Движения.Поголовье.Добавить();
		Движение.Период = Дата;
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Животное = НовыйЖивотный.Ссылка;
        Движение.Количество = 1;
		
		
		
	КонецЦикла;
	// Автоматический запуск бизнес-процесса при проведении поступления
	НовыйПроцесс = БизнесПроцессы.ПриемкаЖивотных.СоздатьБизнесПроцесс();
	НовыйПроцесс.Дата = ТекущаяДата();
	НовыйПроцесс.ДокументПоступления = Ссылка;
	НовыйПроцесс.Записать();
	НовыйПроцесс.Старт();

КонецПроцедуры